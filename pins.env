# What this release of the Grok Bot installs. Read by scripts/install.sh and
# scripts/doctor checks; change only in a release commit.

# The bot's own release. The Start prompt clones this tag.
BOT_RELEASE=v0.1.0

# PickleTime, the booking engine, pinned to an exact commit so a push to its
# main branch can never change what books your court.
PICKLETIME_REPO=https://github.com/kapadias/PickleTime.git
PICKLETIME_COMMIT=81278163c5ea233d703df7754653f795cdc1e788

# Chrome and ChromeDriver from the same Chrome for Testing release, the version
# PickleTime's own Dockerfile pins.
CHROME_VERSION=151.0.7922.71

# Python for the engine (PickleTime needs 3.11+). uv fetches it into /workspace
# when the computer's own python3 is older.
PYTHON_VERSION=3.11
