# What this release of the Grok Bot installs. Read by scripts/install.sh and
# scripts/doctor checks; change only in a release commit.

# The bot's own release. The Start prompt clones this tag.
BOT_RELEASE=v0.1.2

# Chrome and ChromeDriver from the same Chrome for Testing release, so the two
# can never drift apart.
CHROME_VERSION=151.0.7922.71

# Python for the booking engine (3.11+). uv fetches it into /workspace, so the
# computer's own python3 does not matter.
PYTHON_VERSION=3.11
